# ============================================================
# DNTU SKILLBRIDGE BACKEND — DEVELOPMENT TEMPLATE
# Copy to .env, fill local secrets, and never commit the real .env.
# ============================================================
# Active values below are for local development. Configure deployment
# secrets through the host's environment or secret manager.

# ============================================================
# APPLICATION
# ============================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5239

App__Name=DNTU SkillBridge
App__FrontendBaseUrl=http://localhost:5173
App__PublicBaseUrl=http://localhost:5239

# ============================================================
# DATABASE — SQL SERVER
# ============================================================
Database__Host=localhost
Database__Port=1433
Database__Name=skillbridge
Database__Username=sa
# Wrap the value in single quotes if it contains # or whitespace.
Database__Password=CHANGE_ME
Database__Encrypt=true
Database__TrustServerCertificate=true
Database__ConnectTimeout=15

# ============================================================
# JWT / AUTHENTICATION
# ============================================================
Jwt__Issuer=DNTU.SkillBridge.Api
Jwt__Audience=DNTU.SkillBridge.Web
Jwt__SigningKey=CHANGE_ME_USE_A_MINIMUM_64_CHARACTER_SECRET_FOR_LOCAL_DEVELOPMENT_ONLY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ============================================================
# GOOGLE SIGN-IN
# ============================================================
# Web OAuth Client ID from Google Cloud Console (use the same ID in Frontend/.env.local).
# The server verifies Google's signature, audience, verified email and the dntu.edu.vn hosted domain.
GoogleAuth__ClientId=

# ============================================================
# CORS
# ============================================================
Cors__AllowedOrigins__0=http://localhost:5173

# ============================================================
# OBJECT STORAGE / FILEBASE (S3 COMPATIBLE)
# ============================================================
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_BUCKET=my-web-storage
FILEBASE_ACCESS_KEY=your_access_key
FILEBASE_SECRET_KEY=your_secret_key

Storage__Enabled=false
Storage__Provider=Filebase
Storage__Endpoint=https://s3.filebase.io
Storage__Bucket=my-web-storage
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__UseSsl=true
Storage__Region=us-east-1
Storage__UsePathStyle=true

# ============================================================
# EMAIL / RESEND
# ============================================================
Email__Enabled=false
Email__ApiKey=
Email__FromAddress=no-reply@example.com
Email__FromName=DNTU SkillBridge

# Optional: credentials used only by scripts/test-smtp.mjs for a direct Plesk SMTP test.
# The backend itself sends through Resend and does not read these SMTP fields.
Email__Host=localhost
Email__Port=1025
Email__Username=
Email__Password=

# ============================================================
# REDIS
# ============================================================
Redis__Enabled=false
Redis__ConnectionString=localhost:6379

# ============================================================
# PAYMENTS
# ============================================================
Payments__Enabled=false
Payments__Currency=VND
Payments__CheckoutExpirationMinutes=15
Payments__ReconciliationIntervalMinutes=15

# ============================================================
# SEPAY
# ============================================================
SePay__Enabled=false
SePay__Environment=Sandbox
SePay__PaymentGateway__ApiBaseUrl=CHANGE_ME
SePay__PaymentGateway__CheckoutUrl=CHANGE_ME
SePay__PaymentGateway__MerchantId=CHANGE_ME
SePay__PaymentGateway__SecretKey=CHANGE_ME
SePay__PaymentGateway__IpnSecretKey=CHANGE_ME
SePay__PaymentGateway__SuccessUrl=http://localhost:5173/payment/success
SePay__PaymentGateway__ErrorUrl=http://localhost:5173/payment/error
SePay__PaymentGateway__CancelUrl=http://localhost:5173/payment/cancel

# ============================================================
# BACKGROUND JOBS
# ============================================================
Quartz__Enabled=false
Quartz__FileCleanupIntervalMinutes=15
