# Copy this file to .env for development. Never commit the real .env.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

# Application
App__Name=DNTU SkillBridge
App__FrontendBaseUrl=http://localhost:5173
App__PublicBaseUrl=http://localhost:8080

# Database
ConnectionStrings__Default='Server=backend.phelieuminhduc.com,32022;Database=backendskillbridge;User Id=adminbackend;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15'

# JWT
Jwt__Issuer=DNTU.SkillBridge.Api
Jwt__Audience=DNTU.SkillBridge.Web
Jwt__SigningKey=CHANGE_ME_USE_A_MINIMUM_64_CHARACTER_SECRET_FOR_LOCAL_DEVELOPMENT_ONLY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# CORS
Cors__AllowedOrigins__0=http://localhost:5173

# Storage
Storage__Enabled=false
Storage__Provider=MinIO
Storage__Endpoint=http://localhost:9000
Storage__Bucket=skillbridge
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__UseSsl=false
Storage__Region=us-east-1
Storage__UsePathStyle=true

# Email
Email__Enabled=false
Email__Host=localhost
Email__Port=1025
Email__Username=
Email__Password=
Email__FromAddress=no-reply@skillbridge.local
Email__FromName=DNTU SkillBridge

# Redis
Redis__Enabled=false
Redis__ConnectionString=localhost:6379

# Payments
Payments__Enabled=false
Payments__Currency=VND
Payments__CheckoutExpirationMinutes=15
Payments__ReconciliationIntervalMinutes=15

# SePay
SePay__Enabled=false
SePay__Environment=Sandbox
SePay__PaymentGateway__ApiBaseUrl=CHANGE_ME
SePay__PaymentGateway__CheckoutUrl=CHANGE_ME
SePay__PaymentGateway__MerchantId=CHANGE_ME
SePay__PaymentGateway__SecretKey=CHANGE_ME
SePay__PaymentGateway__IpnSecretKey=CHANGE_ME
SePay__PaymentGateway__SuccessUrl=http://localhost:5173/payment/success
SePay__PaymentGateway__ErrorUrl=http://localhost:5173/payment/error
SePay__PaymentGateway__CancelUrl=http://localhost:5173/payment/cancel

# Background jobs
Quartz__Enabled=false
Quartz__FileCleanupIntervalMinutes=15
