{
  "AllowedHosts": "*",
  "App": {
    "Name": "DNTU SkillBridge",
    "FrontendBaseUrl": "http://localhost:5173",
    "PublicBaseUrl": "http://localhost:8080"
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\SkillBridge2022;Database=skillbridge;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DNTU.SkillBridge.Api",
    "Audience": "DNTU.SkillBridge.Web",
    "SigningKey": "CHANGE_ME_MINIMUM_64_CHARACTER_JWT_SIGNING_KEY_FOR_LOCAL_CONFIGURATION",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Storage": {
    "Enabled": false,
    "UploadUrlMinutes": 15,
    "DownloadUrlMinutes": 5,
    "Provider": "MinIO",
    "Endpoint": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": false
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@skillbridge.local",
    "FromName": "DNTU SkillBridge"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Payments": {
    "Enabled": false,
    "Currency": "VND",
    "CheckoutExpirationMinutes": 15,
    "ReconciliationIntervalMinutes": 15
  },
  "SePay": {
    "Enabled": false,
    "Environment": "Sandbox",
    "PaymentGateway": {
      "ApiBaseUrl": "",
      "CheckoutUrl": "",
      "MerchantId": "",
      "SecretKey": "",
      "IpnSecretKey": "",
      "SuccessUrl": "http://localhost:5173/payment/success",
      "ErrorUrl": "http://localhost:5173/payment/error",
      "CancelUrl": "http://localhost:5173/payment/cancel"
    }
  },
  "Quartz": {
    "Enabled": false,
    "FileCleanupIntervalMinutes": 15
  },
  "Catalog": {
    "Project": {
      "Difficulties": [
        "BEGINNER",
        "INTERMEDIATE",
        "ADVANCED"
      ],
      "WorkTypes": [
        "ONSITE",
        "HYBRID",
        "REMOTE"
      ],
      "DurationWeeks": {
        "Min": 4,
        "Max": 52
      },
      "TeamSize": {
        "Min": 2,
        "Max": 8
      },
      "Allowance": {
        "Currency": "VND",
        "Amount": {
          "Min": 0,
          "Max": 100000000
        }
      }
    },
    "Task": {
      "Statuses": [
        "BACKLOG",
        "TODO",
        "IN_PROGRESS",
        "REVIEW",
        "DONE"
      ],
      "Priorities": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}